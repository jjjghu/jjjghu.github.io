---
const currentYear = new Date().getFullYear();
import { UI_TEXT } from "../i18n/ui";
---

<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-section copyright">
      <span
        >Copyright © {currentYear}
        <span
          data-cn={UI_TEXT.header_title.cn}
          data-en={UI_TEXT.header_title.en}>{UI_TEXT.header_title.cn}</span
        > All rights reserved.</span
      >
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border-muted);
    padding: 2rem 0;
    margin-top: 4rem;

    background-color: color-mix(
      in srgb,
      var(--color-canvas-subtle) var(--bg-overlay-alpha),
      transparent
    );
    /* 稍微深一點的背景 */
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
    display: flex;
    justify-content: space-between;
    /* 左右分散對齊 */
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .footer-section {
    display: flex;
    align-items: center;
  }

  /* 版權文字 */
  .copyright {
    color: var(--color-fg-muted);
    font-size: 0.9rem;
  }

  /* 手機版直排 */
  @media (max-width: 768px) {
    .footer-container {
      flex-direction: column;
      text-align: center;
    }

    .footer-section {
      justify-content: center;
    }
  }
</style>
