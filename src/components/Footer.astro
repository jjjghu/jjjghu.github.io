---
const currentYear = new Date().getFullYear();
import { UI_TEXT, t } from "../i18n/ui";
---

<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-section copyright">
      <span
        >Copyright © {currentYear}
        <span
          data-cn={UI_TEXT.header_title.cn}
          data-en={UI_TEXT.header_title.en}>{UI_TEXT.header_title.cn}</span
        > All rights reserved.</span
      >
    </div>
    <div class="footer-section">
      <a class="footer-link" href="/beyond/" {...t("beyond_title")}>{UI_TEXT.beyond_title.cn}</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border-muted);
    padding: 32px 0;
    margin-top: 64px;

    background-color: var(--surface-subtle);
    /* 稍微深一點的背景 */
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 16px;
    display: flex;
    /* 靠左排列：右下角有浮動按鈕，連結放右邊會被蓋住 */
    align-items: center;
    flex-wrap: wrap;
    gap: 24px;
  }

  .footer-section {
    display: flex;
    align-items: center;
  }

  /* 版權文字與頁尾連結 */
  .copyright,
  .footer-link {
    color: var(--color-fg-muted);
    font-size: var(--fs-sm);
  }

  .footer-link:hover {
    color: var(--color-accent-fg);
  }

  /* 手機版直排 */
  @media (max-width: 768px) {
    .footer-container {
      flex-direction: column;
      text-align: center;
    }

    .footer-section {
      justify-content: center;
    }
  }
</style>
