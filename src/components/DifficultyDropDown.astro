---
import { UI_TEXT, t } from "../i18n/ui";
import { getDifficultyClass, getDifficultyLabel, difficultyKey } from "../utils/difficulty";

interface Props {
    // 所有分類的難度；目前分類沒有的選項由 script 隱藏
    difficulties?: string[];
}

const { difficulties = [] } = Astro.props;
---

<div
    id="difficulty-dropdown-container"
    class="dropdown-container difficulty-dropdown-container"
>
    <button id="diff-btn" class="interactive-container md dropdown-btn diff-btn" data-dropdown="diff-menu">
        <i class="bx bx-bar-chart-alt-2"></i>
        <span class="diff-label" {...t("diff_all")}>{UI_TEXT.diff_all.cn}</span>
    </button>

    <div id="diff-menu" class="dropdown-menu diff-menu">
        <div class="dropdown-option diff-option active" data-value="all" {...t("diff_all")}>
            {UI_TEXT.diff_all.cn}
        </div>
        {
            difficulties.map((diff) => (
                <div
                    class={`dropdown-option diff-option ${getDifficultyClass(diff)}`}
                    data-value={difficultyKey(diff)}
                    data-cn={getDifficultyLabel(diff, false)}
                    data-en={getDifficultyLabel(diff, true)}
                >
                    {getDifficultyLabel(diff, false)}
                </div>
            ))
        }
    </div>
</div>

<script>
    import { listState } from "../scripts/listState";
    import { closeDropdown } from "../scripts/dropdown";
    import { setLocalized } from "../scripts/language";

    const diffOptions = document.querySelectorAll<HTMLElement>(".diff-option");
    const diffLabel = document.querySelector<HTMLElement>("#diff-btn .diff-label");

    // 只顯示目前分類實際有的難度
    diffOptions.forEach((option) => {
        const value = option.dataset.value!;
        option.style.display = value === "all" || listState.difficulties.has(value) ? "" : "none";
    });

    listState.subscribe(({ difficulty }) => {
        diffOptions.forEach((option) => {
            const active = option.dataset.value === difficulty;
            option.classList.toggle("active", active);
            if (active) setLocalized(diffLabel, option.dataset.cn, option.dataset.en);
        });
    });

    diffOptions.forEach((option) => {
        option.addEventListener("click", () => {
            listState.update({ difficulty: option.dataset.value });
            closeDropdown("diff-menu");
        });
    });
</script>

<style>
    /* 手機版樣式調整 */
    @media (max-width: 768px) {
        .difficulty-dropdown-container {
            width: 100%; /* 確保容器填滿 Grid 格子 */
        }

        .diff-btn {
            min-width: 0; /* 允許縮小 */
            width: 100%;
        }

        /* 避免文字太長時撐開佈局 */
        .diff-label {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
    }
</style>
