---
import { getTagCN, getTagEN } from "../utils/postHelper.ts";
import "../styles/dropdown.css";
import "../styles/badges.css";
import { UI_TEXT, t, tPlaceholder } from "../i18n/ui";

interface Props {
    tags: string[];
}

const { tags } = Astro.props;
---

<div class="dropdown-container tag-filter-container">
    <button id="tag-filter-btn" class="interactive-container md dropdown-btn" data-dropdown="tag-dropdown">
        <i class="bx bx-filter-alt"></i>
        <span {...t("filter_tags")}>{UI_TEXT.filter_tags.cn}</span>
        <span
            id="selected-count"
            class="badge"
            data-variant="count"
            style="display:none">0</span
        >
    </button>

    <div id="tag-dropdown" class="dropdown-menu tag-dropdown">
        <!-- 1. 搜尋區 -->
        <div class="dropdown-search-container">
            <i class="bx bx-search search-icon"></i>
            <input
                type="text"
                id="tag-search-input"
                class="dropdown-search-input"
                autocomplete="off"
                {...tPlaceholder("tag_search_placeholder")}
            />
        </div>

        <!-- 2. 標籤列表 -->
        <div class="tag-chips-container" id="tag-list">
            {
                tags.map((tag) => {
                    const tagCN = getTagCN(tag);
                    const tagEN = getTagEN(tag);
                    return (
                        <label class="tag-chip">
                            <input type="checkbox" value={tagCN} />
                            <span
                                class="badge"
                                data-variant="filter-chip"
                                data-cn={tagCN}
                                data-en={tagEN}
                            >
                                {tagCN}
                            </span>
                        </label>
                    );
                })
            }
        </div>

        <!-- 3. 底部操作區 -->
        <div class="dropdown-footer">
            <div class="footer-left">
                <button id="logic-toggle" class="logic-btn">
                    <span class="logic-label" {...t("logic_label")}>{UI_TEXT.logic_label.cn}</span>
                    <span id="logic-text" class="logic-value" {...t("logic_and")}>{UI_TEXT.logic_and.cn}</span>
                </button>
                <button id="clear-tags" class="footer-btn text-btn">
                    <i class="bx bx-refresh"></i>
                    <span {...t("reset")}>{UI_TEXT.reset.cn}</span>
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    import { listState } from "../scripts/listState";
    import { setLocalized } from "../scripts/language";
    import { UI_TEXT } from "../i18n/ui";

    const tagFilterBtn = document.getElementById("tag-filter-btn");
    const tagDropdown = document.getElementById("tag-dropdown");
    const clearTagsBtn = document.getElementById("clear-tags");
    const logicToggleBtn = document.getElementById("logic-toggle");
    const logicText = document.getElementById("logic-text");
    const selectedCountBadge = document.getElementById("selected-count");
    const tagSearchInput = document.getElementById("tag-search-input") as HTMLInputElement | null;
    const chips = document.querySelectorAll<HTMLElement>("#tag-list .tag-chip");
    const checkboxes = document.querySelectorAll<HTMLInputElement>('.tag-chip input[type="checkbox"]');

    // 狀態 -> 畫面
    listState.subscribe(({ tags, tagLogic }) => {
        checkboxes.forEach((box) => (box.checked = tags.includes(box.value)));

        if (selectedCountBadge) {
            selectedCountBadge.textContent = String(tags.length);
            selectedCountBadge.style.display = tags.length > 0 ? "inline-flex" : "none";
        }
        tagFilterBtn?.classList.toggle("active", tags.length > 0);

        const logic = tagLogic === "OR" ? UI_TEXT.logic_or : UI_TEXT.logic_and;
        setLocalized(logicText, logic.cn, logic.en);
        logicToggleBtn?.classList.toggle("is-or", tagLogic === "OR");
    });

    // 畫面 -> 狀態
    const checkedTags = () => [...checkboxes].filter((box) => box.checked).map((box) => box.value);

    checkboxes.forEach((box) => box.addEventListener("change", () => listState.update({ tags: checkedTags() })));

    logicToggleBtn?.addEventListener("click", () => {
        listState.update({ tagLogic: logicToggleBtn.classList.contains("is-or") ? "AND" : "OR" });
    });

    clearTagsBtn?.addEventListener("click", () => {
        if (tagSearchInput) {
            tagSearchInput.value = "";
            tagSearchInput.dispatchEvent(new Event("input"));
        }
        listState.update({ tags: [] });
    });

    // 打開時聚焦搜尋框（開關本身由 scripts/dropdown.ts 處理，它在 document 層，晚於這個 handler）
    tagFilterBtn?.addEventListener("click", () => {
        setTimeout(() => {
            if (tagDropdown?.classList.contains("show")) tagSearchInput?.focus();
        }, 100);
    });

    // 標籤搜尋（只影響選單內的顯示，不屬於清單狀態）
    tagSearchInput?.addEventListener("input", () => {
        const term = tagSearchInput.value.toLowerCase();
        chips.forEach((chip) => {
            const badge = chip.querySelector<HTMLElement>(".badge");
            const match = [badge?.dataset.cn, badge?.dataset.en].some((name) => (name || "").toLowerCase().includes(term));
            chip.style.display = match ? "inline-flex" : "none";
        });
    });
</script>

<style>
    /* --- Main Button --- */
    .filter-btn {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 7px 12px;
        background-color: var(--color-canvas-subtle);
        border: 1px solid var(--color-border-default);
        border-radius: 6px;
        color: var(--color-fg-default);
        cursor: pointer;
        font-size: 0.9rem;
        height: 38px;
        transition: all 0.2s;
    }
    .filter-btn:hover {
        background-color: var(--color-border-default);
    }
    .filter-btn.active {
        background-color: rgba(56, 139, 253, 0.15);
        color: #58a6ff;
        border-color: rgba(56, 139, 253, 0.4);
    }

    /* --- Badge Variants --- */

    /* 1. Count Badge */
    .badge[data-variant="count"] {
        --badge-bg: var(--color-accent-fg);
        --badge-fg: white;
        --badge-radius: 10px;
        --badge-px: 6px;
        --badge-py: 0;
        --badge-fs: 0.75rem;
        line-height: 1.4;
    }

    /* 2. Filter Chip Badge */
    .badge[data-variant="filter-chip"] {
        --badge-bg: var(--color-canvas-subtle);
        --badge-border: var(--color-border-muted);
        --badge-fg: var(--color-fg-default);
        --badge-radius: 20px;
        --badge-fs: 0.85rem;
        --badge-py: 4px;
        --badge-px: 10px;
        cursor: pointer;
    }

    .tag-chip:hover .badge[data-variant="filter-chip"] {
        --badge-bg: var(--color-border-default);
        --badge-border: var(--color-border-default);
    }

    /* Selected State for Filter Chip */
    .tag-chip input:checked + .badge[data-variant="filter-chip"] {
        --badge-bg: color-mix(in srgb, var(--color-accent-fg), transparent 60%);
        --badge-fg: var(
            --color-page-bg
        ); /* Ensuring readable contrast against the dim accent, or stick to white/accent-fg?? 
           Original was: color: var(--color-accent-bg); 
           If accent-bg is undefined, it defaults to inherit.
           Let's use a safe color like pure white or a specific variable if we knew content.
           Since accent-fg is usually blue. Blue + 60% transparent is darkish blue on dark theme.
           Wait, `transparent 60%` means 40% opaque color? No, mix(color, transparent 60%) usually means 40% color, 60% transparent.
           If theme is dark, this is a dim background.
           Let's just use `var(--color-fg-default)` or `white` to be safe, or just `var(--color-accent-fg)` for text if background is very dim.
           
           Actually, checking old code:
           background-color: color-mix(..., transparent 60%);
           color: var(--color-accent-bg);
           
           I will use a high contrast color for text. white is usually safe for chips.
           Or maybe `var(--color-fg-default)`.
        */
        --badge-fg: #ffffff;

        --badge-border: color-mix(
            in srgb,
            var(--color-accent-fg),
            transparent 20%
        );
    }

    /* Light Mode Tweak for selected state visibility */
    :global(.light)
        .tag-chip
        input:checked
        + .badge[data-variant="filter-chip"] {
        --badge-fg: #ffffff; /* Make sure text is white on the blueish chip */
    }

    .tag-filter-container {
        position: relative;
    }

    /* --- Dropdown --- */
    .tag-dropdown {
        position: absolute;
        top: 110%;
        left: 0;
        width: 320px;
        background-color: var(--color-canvas-overlay);
        border: 1px solid var(--color-border-default);
        border-radius: 8px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
        z-index: 100;
        display: none;
        flex-direction: column;
        overflow: hidden;
    }
    .tag-dropdown.show {
        display: flex;
    }

    /* --- Search Area --- */
    .dropdown-search-container {
        padding: 10px;
        border-bottom: 1px solid var(--color-border-muted);
        background-color: var(--color-canvas-default);
        position: relative;
    }
    .search-icon {
        position: absolute;
        left: 20px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--color-fg-muted);
        pointer-events: none;
    }
    .dropdown-search-input {
        width: 100%;
        padding: 6px 10px 6px 32px;
        background-color: var(--color-canvas-subtle);
        border: 1px solid var(--color-border-default);
        border-radius: 6px;
        color: var(--color-fg-default);
        font-size: 0.9rem;
        outline: none;
    }
    .dropdown-search-input:focus {
        border-color: var(--color-accent-fg);
        background-color: var(--color-canvas-default);
    }

    /* --- Chips Area --- */
    .tag-chips-container {
        padding: 12px;
        max-height: 300px;
        overflow-y: auto;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-content: flex-start;
        background-color: var(--color-canvas-default);
    }

    .tag-chip {
        cursor: pointer;
        user-select: none;
    }
    .tag-chip input {
        display: none;
    }

    /* --- Footer Area --- */
    /* Most styles moved to dropdown.css */

    .footer-left {
        display: flex;
        gap: 8px;
        align-items: center;
        width: 100%; /* Take full width since Apply is gone */
        justify-content: space-between;
    }

    .footer-btn {
        border: none;
        cursor: pointer;
        font-size: 0.85rem;
        border-radius: 4px;
        padding: 5px 10px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        transition: all 0.2s;
    }

    /* Text Button (Reset) */
    .text-btn {
        background: none;
        color: var(--color-fg-muted);
    }
    .text-btn:hover {
        color: var(--color-fg-default);
        background-color: var(--color-border-muted);
    }

    /* Logic Toggle Button */
    .logic-btn {
        display: flex;
        align-items: center;
        gap: 4px;
        background: none;
        border: 1px solid transparent;
        cursor: pointer;
        font-size: 0.8rem;
        color: var(--color-fg-muted);
        padding: 4px 8px;
        border-radius: 4px;
    }
    .logic-btn:hover {
        background-color: var(--color-border-muted);
        color: var(--color-fg-default);
    }
    .logic-label {
        font-weight: 400;
        opacity: 0.8;
    }
    .logic-value {
        font-weight: 600;
        color: var(--color-accent-fg);
        white-space: nowrap;
    }

    .logic-btn.is-or .logic-value {
        color: #d29922; /* Warning color/Yellow-ish for OR distiction */
    }

    @media (max-width: 768px) {
        .tag-filter-container {
            order: 2;
        }
        .tag-dropdown {
            width: 300px;
        }
    }
</style>
