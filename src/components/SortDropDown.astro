---
import { UI_TEXT, t, type UiKey } from "../i18n/ui";

const options: { field: string; order: string; label: UiKey }[] = [
    { field: "id", order: "asc", label: "sort_id_asc" },
    { field: "id", order: "desc", label: "sort_id_desc" },
    { field: "date", order: "desc", label: "sort_date_newest" },
    { field: "date", order: "asc", label: "sort_date_oldest" },
];
---

<div class="dropdown-container sort-dropdown-container">
    <button id="sort-btn" class="interactive-container md dropdown-btn sort-btn" data-dropdown="sort-menu">
        <i class="bx bx-sort-alt-2"></i>
        <span class="sort-label" {...t("sort_id_asc")}>{UI_TEXT.sort_id_asc.cn}</span>
    </button>
    <div id="sort-menu" class="dropdown-menu sort-menu">
        {
            options.map(({ field, order, label }) => (
                <div class="dropdown-option sort-option" data-field={field} data-order={order} {...t(label)}>
                    {UI_TEXT[label].cn}
                </div>
            ))
        }
    </div>
</div>

<script>
    import { listState } from "../scripts/listState";
    import { closeDropdown } from "../scripts/dropdown";
    import { setLocalized } from "../scripts/language";
    import type { SortConfig } from "../types";

    const sortOptions = document.querySelectorAll<HTMLElement>(".sort-option");
    const sortLabel = document.querySelector<HTMLElement>("#sort-btn .sort-label");

    listState.subscribe(({ sort }) => {
        sortOptions.forEach((option) => {
            const active = option.dataset.field === sort.field && option.dataset.order === sort.order;
            option.classList.toggle("active", active);
            if (active) setLocalized(sortLabel, option.dataset.cn, option.dataset.en);
        });
    });

    sortOptions.forEach((option) => {
        option.addEventListener("click", () => {
            listState.update({ sort: { field: option.dataset.field, order: option.dataset.order } as SortConfig });
            closeDropdown("sort-menu");
        });
    });
</script>
