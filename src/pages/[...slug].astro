---
import { render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import type { PostEntry } from "../types";

import TagBadge from "../components/TagBadge.astro";
import DifficultyBadge from "../components/DifficultyBadge.astro";

import { getPublicPosts, postSlug } from "../utils/postHelper.ts";
import { serializeJson } from "../utils/security";

export async function getStaticPaths() {
    return (await getPublicPosts()).map((post) => ({
        params: { slug: postSlug(post) },
        props: { post },
    }));
}
interface Props {
    post: PostEntry;
}

// 2. 取得資料
const { post } = Astro.props;
const { Content, headings } = await render(post);
const tags = post.data.tags || [];
---

<Layout
    title={post.data.title}
    headings={headings}
    activeCategory={post.collection}
>
    <div class="post-card">
        <div class="post-header-row">
            <h1 id="post-title">
                <a
                    href={post.data.link}
                    id="post-link"
                    data-cn-title={post.data.title}
                    data-cn-link={post.data.link}
                    data-en-title={post.data.en_title || post.data.title}
                    data-en-link={post.data.en_link || post.data.link}
                >
                    {post.data.title}
                </a>
            </h1>
        </div>
        <div class="tags-container">
            <DifficultyBadge difficulty={post.data.difficulty} />
            {tags.map((tag) => <TagBadge tag={tag} />)}
        </div>

        <article class="article-body">
            <Content />
        </article>
    </div>

    <script>
        import { isEnglish, onLanguageChange } from "../scripts/language";
        import { isHttpUrl } from "../utils/security";

        const postLink = document.querySelector<HTMLAnchorElement>("#post-link");

        function updatePostLink(english: boolean) {
            if (!postLink) return;
            const { enTitle, cnTitle, enLink, cnLink } = postLink.dataset;
            postLink.textContent = (english ? enTitle : cnTitle) ?? "";
            const url = english ? enLink : cnLink;
            if (url && isHttpUrl(url)) postLink.href = url;
            else postLink.removeAttribute("href");
        }

        updatePostLink(isEnglish());
        onLanguageChange(updatePostLink);
    </script>

    <script
        is:inline
        type="application/ld+json"
        set:html={serializeJson({
            "@context": "https://schema.org",
            "@type": "Article",
            headline: post.data.title,
            image: [],
            datePublished: post.data.date,
            dateModified: post.data.date,
            author: [
                {
                    "@type": "Person",
                    name: "Chiu",
                    url: "https://jjjghu.github.io",
                },
            ],
        })}
    />

    <style>
        .post-header-row {
            margin-bottom: 8px;
        }

        .tags-container {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 32px;
            margin-top: 16px;
        }

        @media (max-width: 600px) {
            .post-header-row {
                flex-direction: column-reverse;
                align-items: center;
            }
        }
    </style>
</Layout>
