---
import Layout from "../layouts/Layout.astro";
import PostRow from "../components/PostRow.astro";
import TagFilter from "../components/TagFilter.astro";
import SortDropDown from "../components/SortDropDown.astro";
import DifficultyDropDown from "../components/DifficultyDropDown.astro";
import {
  sortPostsById,
  getAllUniqueTags,
  isPublicPost,
  getAllUniqueDifficulties,
  getTagCN,
} from "../utils/postHelper.ts";
import { getCollection } from "astro:content";
import { LEETCODE_COLLECTION, ZEROJUDGE_COLLECTION } from "../constants";
import { UI_TEXT } from "../i18n/ui";
import type { Post } from "../types";
import { generateSlug } from "../utils/slug-generator.mjs";

import "../styles/post-list.css";
import "../styles/utilities.css";

// data
const leetcodePosts = await getCollection(LEETCODE_COLLECTION, isPublicPost);
const zerojudgePosts = await getCollection(ZEROJUDGE_COLLECTION, isPublicPost);
const sortedPosts = sortPostsById([...leetcodePosts, ...zerojudgePosts]);

const allTagsCN = getAllUniqueTags(sortedPosts);
const uniqueTags = Array.from(allTagsCN).sort();

const uniqueDifficultiesLeetcode = getAllUniqueDifficulties(leetcodePosts);
const uniqueDifficultiesZerojudge = getAllUniqueDifficulties(zerojudgePosts);

// 轉換 posts 為 FilterEngine 所需的數據格式
const posts: Post[] = sortedPosts.map((post) => {
  const category = (post.data.category === "zerojudge" ? "zerojudge" : "leetcode") as "leetcode" | "zerojudge";
  // 如果 problem_id 為空，使用 slug 作為 id
  const id = post.data.problem_id || post.slug;
  // 使用 generateSlug 來生成正確的 URL slug（與 [...slug].astro 一致）
  const finalSlug = generateSlug(post.slug, post.data.problem_id);
  return {
    id: id,
    slug: finalSlug,
    category: category,
    title: post.data.title,
    enTitle: post.data.en_title ?? "",
    tagsCN: post.data.tags.map(tag => getTagCN(tag)),
    tagEN: post.data.tags,
    difficulty: post.data.difficulty ?? "",
    date: new Date(post.data.date).getTime(),
    searchContent: `${post.data.problem_id} ${post.data.title} ${post.data.en_title} ${post.data.tags.join(' ')}`.toLowerCase(),
  };
});

// < 轉義避免內容出現 </script> 破壞資料島
const postsJson = JSON.stringify(posts).replace(/</g, "\\u003c");
---

<Layout title={UI_TEXT.header_title.cn}>
  <div class="page-container">
    <div class="filter-bar fouc-loading">
      <div class="search-wrapper">
        <i class="bx bx-search search-icon"></i>
        <input
          type="text"
          id="text-search"
          placeholder={UI_TEXT.search_keywords_placeholder.cn}
          autocomplete="off"
          data-cn-placeholder={UI_TEXT.search_keywords_placeholder.cn}
          data-en-placeholder={UI_TEXT.search_keywords_placeholder.en}
        />
      </div>

      <TagFilter tags={uniqueTags} />

      <div class="filter-controls-group">
        <SortDropDown />
        <div class="difficulty-filter-wrapper">
          <div class="difficulty-filter-wrapper">
            <DifficultyDropDown
              difficultiesLeetcode={uniqueDifficultiesLeetcode}
              difficultiesZerojudge={uniqueDifficultiesZerojudge}
            />
          </div>
        </div>
        <div class="result-count" id="result-count">
          {UI_TEXT.result_count_prefix.cn}
          {sortedPosts.length}
          {UI_TEXT.result_count_suffix.cn}
        </div>
      </div>
    </div>

    <!-- The list container: header + rows share the SAME grid -->
    <div class="file-list-container">
      <div class="file-list-header post-list-grid">
        <div
          class="col-title"
          data-cn={UI_TEXT.col_title.cn}
          data-en={UI_TEXT.col_title.en}
        >
          {UI_TEXT.col_title.cn}
        </div>
        <div
          class="col-difficulty"
          data-cn={UI_TEXT.col_difficulty.cn}
          data-en={UI_TEXT.col_difficulty.en}
        >
          {UI_TEXT.col_difficulty.cn}
        </div>
        <div
          class="col-tags"
          data-cn={UI_TEXT.col_tags.cn}
          data-en={UI_TEXT.col_tags.en}
        >
          {UI_TEXT.col_tags.cn}
        </div>
        <div
          class="col-date"
          data-cn={UI_TEXT.col_date.cn}
          data-en={UI_TEXT.col_date.en}
        >
          {UI_TEXT.col_date.cn}
        </div>
      </div>

      <div id="post-list" class="fouc-loading">
        {posts.map((post) => <PostRow post={post} />)}
      </div>
    </div>

    <div
      id="no-results"
      style="display: none; padding: 2rem; text-align: center; color: var(--color-fg-muted);"
    >
      沒有找到符合的題目。
    </div>
  </div>
</Layout>

<script is:inline type="application/json" id="posts-data" set:html={postsJson} />

<script>
  import { FilterEngine } from "../scripts/filterEngine";
  import { SortEngine } from "../scripts/sortEngine";
  import { STORAGE_KEYS, EVENTS } from "../constants";
  import type { Post, SortConfig } from "../types";

  const posts: Post[] = JSON.parse(
    document.getElementById("posts-data")!.textContent!
  );

  const filterEngine = new FilterEngine();
  const sortEngine = new SortEngine();

  function initFilterSystem() {
    const textSearch = document.getElementById("text-search") as HTMLInputElement | null;
    const postList = document.getElementById("post-list");
    const rows = postList?.querySelectorAll<HTMLElement>(".file-row");
    const noResults = document.getElementById("no-results");
    const resultCount = document.getElementById("result-count");

    // 從 URL 參數讀取分類，默認為 "leetcode"
    const urlParams = new URLSearchParams(window.location.search);
    const categoryParam = urlParams.get("category");

    // 初始狀態主動從 localStorage 讀取（不依賴各 dropdown 的初始事件推送，
    // 避免 module script 執行順序造成的競態）。後續變更才走事件。
    const [savedField, savedOrder] = (
      localStorage.getItem(STORAGE_KEYS.sortPreference) || "id-asc"
    ).split("-");
    let currentSortField = savedField as SortConfig["field"];
    let currentSortOrder = savedOrder as SortConfig["order"];
    let currentDifficulty =
      localStorage.getItem(STORAGE_KEYS.difficultyPreference) || "all";

    let selectedTags = new Set<string>();
    let filterLogic: "AND" | "OR" = "AND";
    try {
      const tagPref = JSON.parse(
        localStorage.getItem(STORAGE_KEYS.tagPreference) || "{}"
      );
      if (Array.isArray(tagPref.tags)) selectedTags = new Set(tagPref.tags);
      if (tagPref.logic === "OR") filterLogic = "OR";
    } catch {}

    let currentCategory = categoryParam || "leetcode";
    let isEnglish = localStorage.getItem(STORAGE_KEYS.isEnglish) === "true";

    function updateFilter() {
      if (!rows || !postList) return;

      const filterResult = filterEngine.filter(posts, {
        tags: selectedTags,
        tagFilterLogic: filterLogic,
        difficulty: currentDifficulty,
        category: currentCategory,
        searchTerm: textSearch?.value.toLowerCase() || "",
      });
      const sortedPosts = sortEngine.sort(filterResult.posts, {
        field: currentSortField,
        order: currentSortOrder,
      });

      const visibleIds = new Set(sortedPosts.map((p) => p.id));

      rows.forEach((row) => {
        row.style.display = visibleIds.has(row.dataset.postId!) ? "grid" : "none";
      });

      sortedPosts.forEach((post) => {
        const row = Array.from(rows).find((r) => r.dataset.postId === post.id);
        if (row) postList.appendChild(row);
      });

      if (noResults && resultCount) {
        noResults.style.display = filterResult.count === 0 ? "block" : "none";
        resultCount.textContent = isEnglish
          ? `Total ${filterResult.count} posts`
          : `共 ${filterResult.count} 篇`;
      }
    }

    // 事件監聽器
    textSearch?.addEventListener("input", updateFilter);

    document.addEventListener(EVENTS.tagFilterChange, (e) => {
      const detail = (e as CustomEvent).detail;
      selectedTags = new Set(detail.selectedTags);
      if (detail.logic) filterLogic = detail.logic;
      updateFilter();
    });

    document.addEventListener(EVENTS.difficultyChange, (e) => {
      currentDifficulty = (e as CustomEvent).detail.value;
      updateFilter();
    });

    document.addEventListener(EVENTS.sortChange, (e) => {
      const detail = (e as CustomEvent).detail;
      currentSortField = detail.field;
      currentSortOrder = detail.order;
      updateFilter();
    });

    document.addEventListener(EVENTS.languageChange, (e) => {
      isEnglish = (e as CustomEvent).detail.isEnglish;
      updateFilter();
    });

    // 初始運行
    updateFilter();

    // 移除 FOUC 隱藏類，顯示內容
    postList?.classList.remove("fouc-loading");
    document.querySelector(".filter-bar")?.classList.remove("fouc-loading");
  }

  // Astro 打包的 script 為 module（deferred），DOM 已就緒
  initFilterSystem();
</script>

<style>
  .page-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .filter-bar {
    display: flex;
    gap: 12px;
    align-items: center;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .search-wrapper {
    position: relative;
    flex: 1;
    min-width: 200px;
    max-width: 500px;
  }

  .search-icon {
    position: absolute;
    left: 10px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-fg-muted);
  }

  #text-search {
    width: 100%;
    padding: 8px 12px 8px 36px;
    background-color: var(--color-canvas-subtle);
    border: 1px solid var(--color-border-default);
    border-radius: 6px;
    color: var(--color-fg-default);
    outline: none;
  }

  #text-search:focus {
    border-color: var(--color-accent-fg);
    background-color: var(--color-canvas-default);
    /* box-shadow: 0 0 15px rgba(88, 166, 255, 0.2); */
  }

  .result-count {
    font-size: 0.85rem;
    color: var(--color-fg-muted);
    margin-left: auto;
  }

  .visitor-count {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 0.85rem;
    color: var(--color-fg-muted);
  }

  .filter-controls-group {
    display: flex;
    gap: 12px;
    align-items: center;
    flex: 1;
  }

  @media (max-width: 768px) {
    .filter-bar {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      align-items: center;
    }

    .filter-controls-group {
      display: contents;
    }

    .search-wrapper {
      order: 1;
      grid-column: span 2;
      width: 100%;
    }

    :global(.sort-dropdown-container) {
      order: 2;
      grid-column: span 1;
    }

    .difficulty-filter-wrapper {
      order: 3;
      grid-column: span 1;
    }

    :global(.tag-filter-container) {
      order: 4;
      grid-column: span 2;
    }

    .result-count {
      order: 5;
      grid-column: span 2;
      text-align: right;
      font-size: 0.8rem;
      margin-top: -4px;
    }

    :global(.drop-btn),
    :global(.dropdown-btn) {
      width: 100%;
      height: 42px;
      justify-content: center;
    }

    :global(.tag-filter-container .dropdown-btn) {
      justify-content: flex-start;
    }

    :global(.diff-btn) {
      justify-content: space-between;
      padding: 0 16px;
    }
  }
</style>
