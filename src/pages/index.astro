---
import Layout from "../layouts/Layout.astro";
import PostRow from "../components/PostRow.astro";
import TagFilter from "../components/TagFilter.astro";
import SortDropDown from "../components/SortDropDown.astro";
import DifficultyDropDown from "../components/DifficultyDropDown.astro";
import {
  getPublicPosts,
  getAllUniqueTags,
  getAllUniqueDifficulties,
  toPost,
} from "../utils/postHelper.ts";
import { UI_TEXT, t, tPlaceholder } from "../i18n/ui";
import { serializeJson } from "../utils/security";

const entries = await getPublicPosts();
const uniqueTags = Array.from(getAllUniqueTags(entries)).sort();
const uniqueDifficulties = getAllUniqueDifficulties(entries);
const posts = entries.map(toPost);

// < 轉義避免內容出現 </script> 破壞資料島
const postsJson = serializeJson(posts);
---

<Layout title={UI_TEXT.header_title.cn}>
  <div class="page-container">
    <div class="filter-bar fouc-loading">
      <div class="search-wrapper">
        <i class="bx bx-search search-icon"></i>
        <input
          type="text"
          id="text-search"
          autocomplete="off"
          {...tPlaceholder("search_keywords_placeholder")}
        />
      </div>

      <TagFilter tags={uniqueTags} />

      <div class="filter-controls-group">
        <SortDropDown />
        <div class="difficulty-filter-wrapper">
          <DifficultyDropDown difficulties={uniqueDifficulties} />
        </div>
        <div class="result-count" id="result-count">
          {UI_TEXT.result_count_prefix.cn}
          {posts.length}
          {UI_TEXT.result_count_suffix.cn}
        </div>
      </div>
    </div>

    <!-- The list container: header + rows share the SAME grid -->
    <div class="file-list-container">
      <div class="file-list-header post-list-grid">
        <div class="col-title" {...t("col_title")}>{UI_TEXT.col_title.cn}</div>
        <div class="col-difficulty" {...t("col_difficulty")}>{UI_TEXT.col_difficulty.cn}</div>
        <div class="col-tags" {...t("col_tags")}>{UI_TEXT.col_tags.cn}</div>
        <div class="col-date" {...t("col_date")}>{UI_TEXT.col_date.cn}</div>
      </div>

      <div id="post-list" class="fouc-loading">
        {posts.map((post) => <PostRow post={post} />)}
      </div>
    </div>

    <div
      id="no-results"
      style="display: none; padding: 2rem; text-align: center; color: var(--color-fg-muted);"
      {...t("no_results")}
    >
      {UI_TEXT.no_results.cn}
    </div>
  </div>
</Layout>

<script is:inline type="application/json" id="posts-data" set:html={postsJson} />

<script>
  import "../scripts/dropdown";
  import { listState } from "../scripts/listState";
  import { text, onLanguageChange } from "../scripts/language";

  const textSearch = document.getElementById("text-search") as HTMLInputElement | null;
  const postList = document.getElementById("post-list")!;
  const noResults = document.getElementById("no-results");
  const resultCount = document.getElementById("result-count");

  const rowBySlug = new Map(
    [...postList.querySelectorAll<HTMLElement>(".file-row")].map((row) => [row.dataset.postSlug!, row]),
  );

  function renderCount(count: number) {
    if (resultCount) {
      resultCount.textContent = `${text("result_count_prefix")} ${count} ${text("result_count_suffix")}`;
    }
  }

  // 狀態 -> 清單：先全部隱藏，再把要顯示的列依序接到尾端
  listState.subscribe(() => {
    const visible = listState.visible();
    rowBySlug.forEach((row) => (row.style.display = "none"));
    visible.forEach((post) => {
      const row = rowBySlug.get(post.slug);
      if (!row) return;
      row.style.display = "grid";
      postList.appendChild(row);
    });
    if (noResults) noResults.style.display = visible.length === 0 ? "block" : "none";
    renderCount(visible.length);
  });

  textSearch?.addEventListener("input", () => listState.update({ searchTerm: textSearch.value }));
  onLanguageChange(() => renderCount(listState.visible().length));

  // 移除 FOUC 隱藏類，顯示內容
  postList.classList.remove("fouc-loading");
  document.querySelector(".filter-bar")?.classList.remove("fouc-loading");
</script>

<style>
  .page-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .filter-bar {
    display: flex;
    gap: 12px;
    align-items: center;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  .search-wrapper {
    position: relative;
    flex: 1;
    min-width: 200px;
    max-width: 500px;
  }

  .search-icon {
    position: absolute;
    left: 10px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-fg-muted);
  }

  #text-search {
    width: 100%;
    height: var(--control-height);
    padding: 8px 12px 8px 36px;
    font-size: var(--fs-sm);
    background-color: var(--color-canvas-subtle);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    color: var(--color-fg-default);
    outline: none;
  }

  #text-search:focus {
    border-color: var(--color-accent-fg);
    background-color: var(--color-canvas-default);
    /* box-shadow: 0 0 15px rgba(88, 166, 255, 0.2); */
  }

  .result-count {
    font-size: var(--fs-sm);
    color: var(--color-fg-muted);
    margin-left: auto;
    white-space: nowrap;
  }

  .filter-controls-group {
    display: flex;
    gap: 12px;
    align-items: center;
    flex: 1;
  }

  @media (max-width: 768px) {
    .filter-bar {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      align-items: center;
    }

    .filter-controls-group {
      display: contents;
    }

    .search-wrapper {
      order: 1;
      grid-column: span 2;
      width: 100%;
    }

    :global(.sort-dropdown-container) {
      order: 2;
      grid-column: span 1;
    }

    .difficulty-filter-wrapper {
      order: 3;
      grid-column: span 1;
    }

    :global(.tag-filter-container) {
      order: 4;
      grid-column: span 2;
    }

    .result-count {
      order: 5;
      grid-column: span 2;
      text-align: right;
      font-size: var(--fs-xs);
      margin-top: -4px;
    }

    :global(.dropdown-btn) {
      width: 100%;
      justify-content: center;
    }

    :global(.tag-filter-container .dropdown-btn) {
      justify-content: flex-start;
    }
  }
</style>
