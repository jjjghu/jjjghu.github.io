---
// 「解題之外」專用版面：刻意不沿用解題站的 Layout。
// 中性的報導式排版：淺灰底、黑體、窄欄、大段距，以時間與日曆為主題。
// 整頁是平的，只有日曆紙（列表頁的月曆、單篇頁的日曆頁）是浮起來的白紙；背後是很淡的年份浮水印。
// 顏色與字級自成一套，不受站內主題（深色／淺色／遊戲）影響。
import "katex/dist/katex.min.css";

interface Props {
    title: string;
    description?: string;
    /** 列表頁用較寬的欄位，左側放月曆 */
    wide?: boolean;
    /** 這一頁的原稿路徑，只在開發模式傳入，讓預覽換頁時編輯器跟著打開它 */
    source?: string;
}

const { title, description = "解題以外的文字", wide = false, source } = Astro.props;
---

<html lang="zh-TW">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <!-- 請搜尋引擎不要索引；這一區也不在 sitemap 裡 -->
        <meta name="robots" content="noindex" />
        <meta name="referrer" content="strict-origin-when-cross-origin" />
        <meta name="theme-color" content="#f1f1f1" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    </head>

    <body data-source={source}>
        <header class="bar">
            <a href="/beyond/">解題之外</a>
            <a href="/">解題筆記</a>
        </header>

        <main class:list={["column", { "column-wide": wide }]}>
            <slot />
        </main>
    </body>
</html>

<script>
    // 編輯時的預覽同步，只在 npm run dev 有作用（正式網站沒有 import.meta.hot，這段整個不會出現）
    if (import.meta.hot) {
        // 存檔某篇文章：網頁跳到那一篇（通知來自 plugins/beyond-preview-sync.mjs）
        import.meta.hot.on("beyond:edit", ({ slug }: { slug: string }) => {
            const target = `/beyond/${slug}/`;
            if (decodeURI(location.pathname) !== target) location.assign(encodeURI(target));
        });
        // 預覽換頁：通知擴充功能打開這一篇的原稿（tools/beyond-preview/，打開時游標留在網頁上）。
        // 存檔造成的重新整理不算換頁。
        const source = document.body.dataset.source;
        const navigation = performance.getEntriesByType("navigation")[0] as PerformanceNavigationTiming | undefined;
        if (source && navigation?.type !== "reload") {
            fetch(`/__beyond-page?file=${encodeURIComponent(source)}`);
        }
    }
</script>

<style is:global>
    :root {
        --bz-white: #ffffff;
        --bz-bg: #f1f1f1;
        --bz-fg: #2d2d2d;
        --bz-strong: #111111;
        --bz-muted: #666666;
        --bz-faint: #b3b3b3; /* 月曆上沒有文章的日子 */
        --bz-mark: #e7e7e7; /* 年份浮水印，只比底色深一點 */
        --bz-rule: #d9d9d9;
        --bz-accent: #0969da; /* 解題站淺色主題的強調色，維持一點關聯 */
        /* 解題站的強調色變數；/color 片段寫的 <span style="color:var(--color-accent-fg)"> 在這裡也有顏色 */
        --color-accent-fg: var(--bz-accent);
        --bz-paper-shadow: 0 1px 2px rgb(0 0 0 / 0.06), 0 8px 24px rgb(0 0 0 / 0.08);
        /* 和解題站（styles/global.css 的 body）同一組字體 */
        --bz-sans:
            -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans", Helvetica, Arial, sans-serif,
            "Apple Color Emoji", "Segoe UI Emoji";
        --bz-mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        --cal-flip: 350ms; /* 和 pages/beyond/index.astro 的 FLIP_MS 一致 */
    }

    *,
    *::before,
    *::after {
        box-sizing: border-box;
    }

    html {
        scroll-behavior: smooth;
    }

    @media (prefers-reduced-motion: reduce) {
        html {
            scroll-behavior: auto;
        }

        * {
            animation: none !important;
            transition: none !important;
        }
    }

    body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        margin: 0;
        background-color: var(--bz-bg);
        color: var(--bz-fg);
        font-family: var(--bz-sans);
        font-size: 18px;
        font-weight: 400; /* 內文用中等字重；字體沒有這個字重時瀏覽器會退回一般字重 */
        line-height: 2;
    }

    ::selection {
        background-color: #383838; /* 深灰，不用純黑 */
        color: var(--bz-white);
    }

    /* 捲軸和解題筆記相同（styles/global.css）：8px 細條、沒有箭頭，滑過時加深 */
    ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
    }

    ::-webkit-scrollbar-track,
    ::-webkit-scrollbar-corner {
        background-color: transparent;
    }

    ::-webkit-scrollbar-thumb {
        background-color: var(--bz-rule);
        border-radius: 4px;
    }

    ::-webkit-scrollbar-thumb:hover {
        background-color: var(--bz-muted);
    }

    * {
        scrollbar-width: thin; /* Firefox */
        scrollbar-color: var(--bz-rule) transparent;
    }

    a {
        color: inherit;
    }

    a:focus-visible,
    button:focus-visible {
        outline: 2px solid var(--bz-accent);
        outline-offset: 4px;
    }

    /* ---- 頂端一行小字：左邊回解題站，右邊回這一區的列表 ---- */
    .bar {
        display: flex;
        justify-content: space-between;
        padding: 12px 24px; /* 連結本身撐到 44px 高（手機好點），所以外框少留一點，文字位置不變 */
        color: var(--bz-muted);
        font-size: 14px;
        letter-spacing: 0.1em;
        line-height: 1.5;
    }

    .bar a {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        text-decoration: none;
    }

    .bar a:hover {
        color: var(--bz-accent);
    }

    /* ---- 欄位 ---- */
    .column {
        position: relative;
        flex: 1;
        width: 100%;
        max-width: 768px; /* 720px 內容 + 左右各 24px，18px 字級下每行約 40 字 */
        margin: 0 auto;
        padding: 64px 24px 96px;
    }

    .column-wide {
        max-width: 1016px;
    }

    /* ---- 標題：和內文同一欄，不另外做大標題區 ---- */
    .title {
        position: relative;
        margin-bottom: 64px;
    }

    .title h1 {
        margin: 0;
        color: var(--bz-strong);
        font-size: 32px;
        font-weight: 700;
        line-height: 1.5;
    }

    .title-note {
        margin-top: 8px;
        color: var(--bz-muted);
        font-size: 16px;
    }

    .title-with-leaf {
        display: flex;
        align-items: flex-start;
        gap: 24px;
    }

    /* ---- 日曆紙：月曆和單篇頁的日曆頁共用。白紙、深色裝訂邊、柔和的陰影 ---- */
    .leaf,
    .cal-sheet {
        border-top: 12px solid var(--bz-strong);
        border-radius: 4px;
        background-color: var(--bz-white);
        box-shadow: var(--bz-paper-shadow);
    }

    .leaf {
        display: flex;
        flex: none;
        flex-direction: column;
        align-items: center;
        width: 96px;
        padding: 8px 8px 12px;
        text-align: center;
    }

    .leaf-day {
        color: var(--bz-strong);
        font-size: 40px;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
        line-height: 1.25;
    }

    .leaf-sub {
        color: var(--bz-muted);
        font-size: 12px;
        white-space: nowrap;
        line-height: 1.5;
    }

    /* 單篇頁的年份浮水印：在標題區後方靠右，完整顯示 */
    .page-mark {
        position: absolute;
        top: 0;
        right: 0;
        z-index: -1;
        color: var(--bz-mark);
        font-size: 240px;
        font-weight: 900;
        font-variant-numeric: tabular-nums;
        line-height: 1;
        pointer-events: none;
        user-select: none;
    }

    .draft-note {
        margin: 0 0 32px;
        padding: 8px 16px;
        border-left: 4px solid #bf8700;
        background-color: var(--bz-white);
        font-size: 14px;
        line-height: 1.75;
    }

    .draft-tag {
        display: inline-block;
        padding: 0 8px;
        border: 1px solid #bf8700;
        border-radius: 4px;
        color: #7d4e00;
        font-size: 12px;
        font-weight: 400;
        letter-spacing: 0;
        line-height: 1.5;
        white-space: nowrap;
    }

    /* ---- 內文：淺灰底、720px 欄寬、大段距 ---- */
    .body p {
        margin: 0 0 var(--bz-para);
        white-space: pre-line; /* 日記原稿的單一換行直接顯示成換行，不必改寫成 Markdown */
    }

    .body > :last-child {
        margin-bottom: 0;
    }

    /* 連結不變色，用深色底線表示；滑過時底線加粗 */
    .body a {
        color: inherit;
        text-decoration: underline var(--bz-strong) 1px;
        text-underline-offset: 4px;
    }

    .body a:hover {
        text-decoration-thickness: 2px;
    }

    /* 標題：上方只比段距多一點，下方貼近它帶領的內文；大小分三級 */
    .body h1,
    .body h2,
    .body h3 {
        margin: 64px 0 16px;
        color: var(--bz-strong);
        font-weight: 700;
        line-height: 1.5;
    }

    .body h1 {
        font-size: 28px;
    }

    .body h2 {
        margin-top: 48px;
        font-size: 22px;
    }

    .body h3 {
        margin-top: 48px;
        font-size: 18px;
    }

    /* 標題緊接著標題（大標下面直接是小標）或在文章開頭時，不再疊加上方的空隙 */
    .body :is(h1, h2, h3) + :is(h1, h2, h3),
    .body > :is(h1, h2, h3):first-child {
        margin-top: 0;
    }

    /* 引言是日記裡的補充說明與 A、B 對話：灰色的段落，左邊一條細線 */
    .body blockquote {
        margin: 0 0 var(--bz-para);
        padding-left: 16px;
        border-left: 2px solid var(--bz-rule);
        color: var(--bz-muted);
    }

    /* 排版照原稿的空行（像 Lark）：原稿空一行 = 版面空一行（--bz-para，一個行高）；
       沒有空行的區塊帶 class="tight"（plugins/rehype-tight.mjs 加上），和上一個區塊之間不留間距。
       任何區塊預設下方都留一行，直接寫 <div> 之類沒有專屬樣式的區塊也一樣；下面各種區塊的規則比這條優先。 */
    .body {
        --bz-para: 2em;
    }

    .body > * {
        margin: 0 0 var(--bz-para);
    }

    .body .tight {
        margin-top: 0;
    }

    .body :has(+ .tight) {
        margin-bottom: 0;
    }

    .body blockquote p {
        margin-bottom: var(--bz-para);
    }

    .body blockquote > :last-child {
        margin-bottom: 0;
    }

    .body ul,
    .body ol {
        margin: 0 0 var(--bz-para);
        padding-left: 28px;
    }

    .body img {
        display: block;
        max-width: 100%;
        height: auto;
        margin: 64px auto;
    }

    /* 連結卡片（plugins/remark-link-card.mjs）：一張白紙，左邊縮圖、右邊標題與來源；滑過時標題加底線，和內文連結一致 */
    .body .link-card {
        display: flex;
        gap: 20px;
        align-items: flex-start;
        margin: 0 0 var(--bz-para);
        padding: 16px;
        background: var(--bz-white);
        box-shadow: var(--bz-paper-shadow);
        color: inherit;
        text-decoration: none;
        line-height: 1.6;
        scroll-margin-top: 32px; /* 從跳轉清單過來時，卡片上方留一點空 */
    }

    .body .link-card img {
        flex: none;
        width: 200px;
        margin: 0;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        background: var(--bz-mark);
    }

    /* Steam 的橫幅圖比較扁，維持原比例才不會切到遊戲名稱 */
    .body .link-card img[src*="/steam-"] {
        aspect-ratio: 460 / 215;
    }

    .card-body {
        display: flex;
        flex-direction: column;
        gap: 4px;
        min-width: 0;
    }

    .card-title {
        color: var(--bz-strong);
        font-weight: 700;
        text-underline-offset: 4px;
    }

    .link-card:hover .card-title {
        text-decoration: underline var(--bz-strong) 2px;
    }

    .card-meta,
    .card-desc {
        color: var(--bz-muted);
        font-size: 14px;
    }

    .card-title,
    .card-desc {
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
        line-clamp: 2;
        overflow: hidden;
    }

    @media (max-width: 599px) {
        .body .link-card {
            flex-direction: column;
            gap: 12px;
        }

        .body .link-card img {
            width: 100%;
        }
    }

    /* 長期紀錄裡，卡片下一行沒空行就接著寫的心得貼近卡片，看得出是同一組 */
    .record-body .link-card + .card-follow {
        margin-top: calc(16px - var(--bz-para));
    }

    /* 長期紀錄的跳轉清單：窄螢幕在文章開頭、預設收合；寬螢幕固定在內文右側，目前讀到的那項加深 */
    .toc {
        margin: 0 0 40px;
        font-size: 15px;
    }

    .toc summary {
        padding: 8px 0; /* 手機上的展開列至少 44px 高 */
        cursor: pointer;
        color: var(--bz-muted);
    }

    .toc ol {
        margin: 12px 0 0;
        padding: 0;
        list-style: none;
        line-height: 1.6;
    }

    .toc a {
        display: block;
        padding: 4px 0 4px 12px;
        border-left: 2px solid var(--bz-rule);
        color: var(--bz-muted);
        text-decoration: none;
    }

    .toc a:hover {
        color: var(--bz-strong);
    }

    .toc a[aria-current] {
        border-left-color: var(--bz-strong);
        color: var(--bz-strong);
        font-weight: 700;
    }

    @media (min-width: 1200px) {
        .with-toc {
            position: relative;
        }

        .toc {
            position: absolute;
            top: 0;
            bottom: 0;
            left: calc(100% + 32px);
            /* 盡量用滿內文右側的空白：(100vw - 100%) / 2 是內文右邊的寬度，扣掉左邊 32px 間距與右邊留白；
               最窄 176px（1200px 寬的螢幕剛好放得下），最寬 320px。還是放不下的名稱單行省略（見下方 .toc a） */
            width: clamp(176px, calc((100vw - 100%) / 2 - 48px), 320px);
            margin: 0;
        }

        /* 每項一行，太長的名稱以「…」省略，完整名稱在 title 提示裡 */
        .toc a {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .toc-box {
            position: sticky;
            top: 96px;
            max-height: calc(100vh - 128px);
            overflow-y: auto;
        }

        /* 寬螢幕上清單一直展開，「目錄」只是標籤 */
        .toc summary {
            padding: 0;
            pointer-events: none;
            list-style: none;
        }

        .toc summary::-webkit-details-marker {
            display: none;
        }
    }

    .body hr {
        margin: 48px 0;
        border: 0;
        border-top: 1px solid var(--bz-rule);
    }

    .body code {
        font-family: var(--bz-mono);
        font-size: 0.85em;
    }

    .body pre {
        margin: 0 0 48px;
        padding: 16px;
        overflow: auto;
        border-radius: 4px;
        background-color: var(--bz-white);
        line-height: 1.5;
    }

    /* ---- 列表頁：區塊標題（長期紀錄、每一年） ---- */
    .section-head {
        position: relative;
        display: flex;
        align-items: baseline;
        gap: 12px;
        margin: 0;
        padding-bottom: 8px;
        border-bottom: 2px solid var(--bz-strong);
        color: var(--bz-strong);
        font-size: 20px;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
        line-height: 1.5;
    }

    .section-count {
        color: var(--bz-muted);
        font-size: 14px;
        font-weight: 400;
        letter-spacing: 0.1em;
    }

    /* ---- 列表頁：長期紀錄，只列標題 ---- */
    .records {
        margin-bottom: 64px;
    }

    .record-list {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        column-gap: 24px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .record-list a {
        display: flex;
        align-items: center;
        gap: 8px;
        min-height: 48px;
        padding: 8px;
        border-bottom: 1px solid var(--bz-rule);
        color: var(--bz-strong);
        font-size: 16px;
        font-weight: 700;
        line-height: 1.5;
        text-decoration: none;
        transition:
            background-color 0.2s,
            color 0.2s;
    }

    .record-icon {
        flex: none;
        width: 20px;
        height: 20px;
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .record-list a:hover {
        background-color: var(--bz-white);
        color: var(--bz-accent);
    }

    /* ---- 列表頁：時間軸。寬螢幕時月曆固定在左側 ---- */
    .year {
        display: grid; /* 浮水印和內容疊在同一格 */
        margin-bottom: 64px;
    }

    .year-body {
        grid-area: 1 / 1;
        min-width: 0;
    }

    /* 年份浮水印：捲過這一年時數字停在畫面中段。它和內容疊在同一格、有實際高度，
       所以 sticky 會讓數字完整留在這一年的範圍內，不會壓到下一年。 */
    .year-mark {
        grid-area: 1 / 1;
        position: sticky;
        top: 32vh;
        align-self: start;
        height: 240px;
        color: var(--bz-mark);
        font-size: 240px;
        font-weight: 900;
        font-variant-numeric: tabular-nums;
        line-height: 1;
        text-align: right;
        pointer-events: none;
        user-select: none;
    }

    .list {
        position: relative;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .list a {
        display: grid;
        grid-template-columns: 72px 1fr;
        gap: 16px;
        padding: 20px 8px;
        border-bottom: 1px solid var(--bz-rule);
        text-decoration: none;
        transition: background-color 0.2s;
    }

    .list a:hover {
        background-color: var(--bz-white);
    }

    .row-date {
        color: var(--bz-accent);
        font-size: 20px;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
        line-height: 1.5;
    }

    .row-weekday {
        display: block;
        color: var(--bz-muted);
        font-size: 12px;
        font-weight: 400;
        letter-spacing: 0.1em;
    }

    .list-title {
        display: block;
        color: var(--bz-strong);
        font-size: 20px;
        font-weight: 700;
        line-height: 1.5;
    }

    .list a:hover .list-title {
        color: var(--bz-accent);
    }

    .row-excerpt {
        display: -webkit-box;
        overflow: hidden;
        color: var(--bz-muted);
        font-size: 15px;
        line-height: 1.75;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
        line-clamp: 2;
    }

    /* 沒有標題的日記：摘要就是主角，用內文色 */
    .row-excerpt:first-child {
        color: var(--bz-fg);
        font-size: 16px;
    }

    /* ---- 月曆 ---- */
    .cal-sheets {
        display: grid; /* 所有月份疊在同一格，高度一致 */
        perspective: 900px;
    }

    .cal-sheet {
        grid-area: 1 / 1;
        visibility: hidden;
        padding: 12px 16px 16px;
        transform-origin: top center;
    }

    .cal-sheet.is-current,
    .cal-sheet.is-under {
        visibility: visible;
    }

    /* 撕頁：以上緣為軸掀起。往更早的月份是掀走目前這張，往較新的月份是新的一張蓋下來 */
    .cal-sheet.is-leaving {
        z-index: 2;
        visibility: visible;
        animation: cal-tear var(--cal-flip) ease-in forwards;
    }

    .cal-sheet.is-entering {
        z-index: 2;
        animation: cal-tear var(--cal-flip) ease-out reverse backwards;
    }

    @keyframes cal-tear {
        to {
            opacity: 0;
